{
  "name": "craft-on-whales",
  "version": "0.9.8",
  "description": "Minecraft Server Manager — a complete control panel for itzg/docker-minecraft-server",
  "private": true,
  "license": "MIT",
  "author": "anefzaoui",
  "homepage": "https://github.com/leocov-dev/craft-on-whales#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/leocov-dev/craft-on-whales.git"
  },
  "bugs": {
    "url": "https://github.com/leocov-dev/craft-on-whales/issues"
  },
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "dev": "concurrently -n frontend,backend -c blue,green \"npm:frontend:dev\" \"npm:backend:dev\"",
    "frontend:dev": "npm --prefix frontend run dev",
    "frontend:build": "npm --prefix frontend run build",
    "backend:dev": "npm --prefix backend run start:dev",
    "backend:build": "npm --prefix backend run build",
    "lint": "eslint tools eslint.config.js",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "concurrently": "^9.1.0",
    "eslint": "^9.39.5",
    "globals": "^17.7.0",
    "prettier": "^3.4.2",
    "semantic-release": "^24.2.9"
  }
}
