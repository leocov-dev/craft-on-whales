{{> page-header heading="ROUTER" sub="Multiplex Minecraft servers behind one port via mc-router, with optional auto-scale."}}

<div class="grid gap-4 lg:grid-cols-2" id="mc-router-page">
  <div class="card p-4">
    <h3 class="mb-4 font-semibold">mc-router</h3>
    <div class="mb-4 flex items-center gap-2">
      <label class="msm-toggle"><input type="checkbox" id="mr-enabled" {{#if config.enabled}}checked{{/if}}><span></span></label>
      <label class="label mb-0" for="mr-enabled">Enable mc-router</label>
    </div>
    <p class="help mb-4 max-w-prose">
      Starts a managed <span class="font-mono">itzg/mc-router</span> container that proxies Minecraft client
      connections by hostname to your servers. It needs read-write access to the Docker socket to start/stop
      servers automatically — the same access level as this panel itself.
    </p>
    <div class="mb-4">
      <label class="label" for="mr-port">Listen port</label>
      <input class="input" id="mr-port" type="number" min="1024" max="65535" value="{{config.listenPort}}">
      <p class="help">The public port players connect to. Move any server still directly publishing host port 25565 to a different port to avoid a conflict.</p>
    </div>
    <h3 class="mt-6 mb-3 font-semibold">Auto-scale</h3>
    <div class="mb-3 flex items-center gap-2">
      <label class="msm-toggle"><input type="checkbox" id="mr-scale-up" {{#if config.autoScaleUp}}checked{{/if}}><span></span></label>
      <label class="label mb-0" for="mr-scale-up">Start a server when a player connects to its hostname</label>
    </div>
    <div class="mb-3 flex items-center gap-2">
      <label class="msm-toggle"><input type="checkbox" id="mr-scale-down" {{#if config.autoScaleDown}}checked{{/if}}><span></span></label>
      <label class="label mb-0" for="mr-scale-down">Stop a server after it's idle</label>
    </div>
    <div class="mb-4">
      <label class="label" for="mr-scale-after">Idle timeout</label>
      <input class="input w-32" id="mr-scale-after" value="{{config.autoScaleDownAfter}}" placeholder="10m">
      <p class="help">A duration like <span class="font-mono">10m</span>, <span class="font-mono">1h</span>, or <span class="font-mono">30s</span>.</p>
    </div>
    <div class="mb-4">
      <label class="label" for="mr-motd-asleep">Asleep MOTD</label>
      <input class="input" id="mr-motd-asleep" value="{{config.autoScaleAsleepMotd}}" placeholder="Server is sleeping — connect to wake it">
    </div>
    <div class="mb-4">
      <label class="label" for="mr-motd-loading">Loading MOTD</label>
      <input class="input" id="mr-motd-loading" value="{{config.autoScaleLoadingMotd}}" placeholder="Server is starting…">
    </div>
    <button class="btn" id="mr-save">Save</button>
  </div>

  <div class="card p-4">
    <h3 class="mb-4 font-semibold">Routes</h3>
    <div class="overflow-x-auto">
      <table class="table-base" id="mr-routes-table">
        <thead><tr><th>Server</th><th>Hostname</th><th>Auto-scale</th><th class="text-right"></th></tr></thead>
        <tbody>
          {{#each routes}}
            <tr data-server-id="{{id}}">
              <td class="font-medium">{{name}}</td>
              <td><input class="input font-mono" data-route-hostname value="{{hostname}}" placeholder="mc.example.com"></td>
              <td>
                <select class="input w-auto" data-route-autoscale>
                  <option value="" {{#unless autoScale}}selected{{/unless}}>Default</option>
                  <option value="on" {{#if (eq autoScale 'on')}}selected{{/if}}>On</option>
                  <option value="off" {{#if (eq autoScale 'off')}}selected{{/if}}>Off</option>
                </select>
              </td>
              <td class="text-right"><button class="btn btn-sm" data-route-save>Save</button></td>
            </tr>
          {{/each}}
        </tbody>
      </table>
    </div>
    <p class="help mt-3 max-w-prose">
      Setting or clearing a hostname requires recreating that server's container to apply the new routing labels
      — it happens automatically the next time the server starts, or immediately if it's already running.
    </p>
  </div>
</div>
<script type="module" src="/js/pages/mcRouter.js"></script>
